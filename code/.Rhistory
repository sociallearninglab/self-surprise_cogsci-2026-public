df.qualitative =
df.chance %>%
# exclude incomplete sessions (n = 6)
filter(completed == T) %>%
# exclude children who chose fewer than 3 marked cards in unsurprising (n = 5)
filter(!(condition == "Cued" & no_marked_cards != 3))
# but keep kids who were distracted
df.qualitative %>%
count(condition, prediction)
summary(
clm(surprise_binary ~ condition,
data = df.qualitative %>%
filter(prediction == 3))
)
summary(
clm(surprise_likert ~ condition,
data = df.qualitative %>%
filter(prediction == 3))
)
df.qualitative =
df.memory %>%
mutate(date =
ymd(str_extract(subject_id, "^\\d{4}-\\d{2}-\\d{2}"))) %>%
# filter pilot sessions
filter(date > "2025-12-14") %>%
# filter participants too young (under 4; n = 1)
filter(age_years > 4.00) %>%
# exclude incomplete sessions (n = 4)
filter(completed == T) %>%
# exclude wrong control q answers (n = 7)
filter(controlq == 1) %>%
# exclude 'Expected Success' participants who chose fewer than 3 marked cards (n = 5)
filter(!(condition == "Cued" &
n_star_cards_selected != 3))
df.qualitative %>%
count(condition, prediction)
summary(
clm(surprise_binary ~ condition,
data = df.qualitative %>%
filter(prediction == 3))
)
summary(
clm(surprise_binary ~ condition * age_bin,
data = df.qualitative)
)
summary(
clm(surprise_likert ~ condition,
data = df.qualitative %>%
filter(prediction == 3))
)
summary(
clm(surprise_likert ~ condition * age_bin,
data = df.qualitative)
)
