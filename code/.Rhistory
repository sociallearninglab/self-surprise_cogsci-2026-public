df.distance %>%
filter(condition == "Uncued") %>%
group_by(choice) %>%
summarise(mean = mean(distance, na.rm = T),
sd = sd(distance, na.rm = T))
summary(lm(distance ~ choice, data = df.distance %>%  filter(condition == "Uncued")))
ggplot(df.memory_analysis,
aes(x = mean_manhattan_distance)) +
geom_histogram(color = "white", bins = 10,
fill = "black") +
labs(x = "Mean manhattan distance across trials",
y = "# of children",
title = "Distribution of mean manhattan distance across 3 trials") +
scale_x_continuous(limits = c(0, 3),
breaks = seq(0, 3, by = 0.33)) +
theme_classic(base_size = 24)
df.distance %>%
filter(condition == "Uncued") %>%
ggplot(aes(x = choice, y = distance)) +
geom_boxplot(width = .15, outlier.shape = NA) +
geom_jitter(width = .05, height = .02, alpha = .3, size = 4) +
labs(x = "Choice", y = "Distance to true location (Manhattan)",
title = "Per-trial distance between participant choice and true location") +
theme_classic(base_size = 24)
df.distance %>%
filter(condition == "Uncued") %>%
ggplot(aes(x = choice, y = distance,
group = subject_id)) +
geom_line(alpha = 0.3, size = 1, color = "steelblue") +
geom_jitter(height = 0, width = .05, alpha = 0.3, size = 5) +
labs(x = "Trial", y = "Manhattan distance",
title = "WITHIN-PARTICIPANT trajectories:\nDistance between participant choice and true card location across trials") +
theme_classic(base_size = 24)
temp =
df.memory_analysis %>%
filter(condition == "Uncued")
summary(clm(surprise_binary ~ 1 + mean_manhattan_distance,
data = temp))
summary(clm(surprise_likert ~ 1 + mean_manhattan_distance,
data = temp))
plot.correlation =
temp %>%
ggplot(aes(x = mean_manhattan_distance,
y = surprise_likert)) +
geom_dotplot(dotsize = .5,
binaxis = "x",
stackratio = 1,
color = "black",
fill = "lightblue") +
scale_x_continuous(limits = c(0, 3),
breaks = c(seq(0, 3, .333))) +
labs(x = "Mean Manhattan Distance of Card Picks",
y = "Post-Hoc Surprise Response")
plot.correlation
ggsave((paste0(figures_dir, "memory/distance_correlation.png")),
plot = plot.correlation,
width = 12, height = 8, device = "png")
df.memory_analysis %>%
count(condition, prediction)
df.memory_analysis %>%
mutate(prediction_numerical =
case_when(prediction == "0" ~ 0,
prediction == "1" ~ 1,
prediction == "2" ~ 2,
prediction == "3" ~ 3)) %>%
group_by(condition) %>%
summarise(mean = mean(prediction_numerical),
sd = sd(prediction_numerical))
df.memory_analysis %>%
count(condition, n_star_cards_selected)
df.memory_analysis %>%
group_by(condition) %>%
summarise(mean = mean(n_star_cards_selected),
median = median(n_star_cards_selected),
sd = sd(n_star_cards_selected))
t.test(as.numeric(prediction) ~ condition,
alternative = "two.sided",
data = df.memory_analysis)
# Children's true performance is .63.
temp =
df.memory_analysis %>%
# convert prediction scale values to numeric
mutate(prediction_numerical =
case_when(prediction == "0" ~ 0,
prediction == "1" ~ 1,
prediction == "2" ~ 2,
prediction == "3" ~ 3)) %>%
filter(condition == "Uncued")
# run t-test
t.test(temp$prediction_numerical,
mu = mean(temp$n_star_cards_selected),
alternative = "two.sided")
temp =
df.memory_analysis %>%
filter(condition == "Uncued") %>%
mutate(surprise_binary = case_when(surprise_binary == "Surprised" ~ 1,
surprise_binary == "Not surprised" ~ 0))
t.test(as.numeric(temp$surprise_binary),
mu = .5,
alternative = "greater")
df.memory_analysis %>%
count(condition, surprise_binary)
df.memory_analysis %>%
mutate(surprise_binary_numerical =
case_when(surprise_binary == "Not surprised" ~ 0,
surprise_binary == "Surprised" ~ 1)) %>%
group_by(condition) %>%
summarise(mean = mean(surprise_binary_numerical),
sd = sd(surprise_binary_numerical))
# logistic regression
fit.memory_surprise =
clm(
# binary surprise is DV
surprise_binary ~
# intercept
1 +
# condition as predictor
condition,
# control for true performance
# n_star_cards_selected,
data = df.memory_analysis)
# print model outputs
fit.memory_surprise %>%
summary()
# plot model predictions
probs.memory_surprise =
ggpredict(fit.memory_surprise)
probs.memory_surprise
plot(probs.memory_surprise) +
ylim(0, 1) +
labs(title = "Predicted Probabilities per Surprise Scale Value",
subtitle = "1 = Not surprised, 2 = Surprised",
x = "Condition, age_years] ",
y = "Predicted Probability") +
theme_classic(base_size = 18)
